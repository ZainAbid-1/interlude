{
  "expo": {
    "name": "interlude",
    "slug": "interlude",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "interlude",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#0a0a0a"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "backgroundColor": "#0a0a0a",
      "package": "com.zainabid_12.interlude"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-audio",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0a0a0a",
          "defaultChannel": "challenges"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0d28e7f-c3a6-4557-8bd2-0fb77023a5e9"
      }
    }
  }
}
